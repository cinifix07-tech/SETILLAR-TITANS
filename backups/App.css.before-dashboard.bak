@media(max-width:780px){.sidebar{transform:translateX(-100%);transition:transform .22s;width:250px;box-shadow:15px 0 40px #0008}.sidebar.open{transform:translateX(0)}.main-area{width:100%;margin:0}.topbar{height:53px;padding:0 17px}.mobile-menu{display:block;border:0;background:none;color:#b8c6d5;font-size:19px;padding:4px 8px 4px 0}.breadcrumb{font-size:9px}.top-right{gap:9px}.network{font-size:8px}.top-divider,.mission-id{display:none}.content{padding:24px 16px 14px}.page-heading{align-items:flex-start}.heading-meta{display:none}.page-heading h1{font-size:32px}.page-heading p{font-size:11px;max-width:350px;line-height:1.55}.stepper{margin:0 -2px 13px;padding:4px;justify-content:flex-start}.step{flex:0 0 auto;padding:7px 9px;gap:5px}.step .step-num{width:18px;height:18px}.workspace{grid-template-columns:1fr}.resources-panel{grid-row:1;padding:15px}.resource-intro{margin-bottom:12px}.resource{padding:9px 0}.resource:nth-of-type(n+4){display:none}.resource-divider{margin:2px 0 9px}.assumption-note{margin-top:10px}.builder-panel{min-height:520px;padding:17px}.objective-grid{grid-template-columns:1fr;gap:8px;margin:18px 0}.objective-card{display:grid;grid-template-columns:36px 1fr 20px;align-items:center;column-gap:10px;padding:10px}.obj-icon{grid-row:span 3;margin:0;width:32px;height:32px}.objective-card strong{font-size:12px}.obj-desc{min-height:0;margin-top:3px}.obj-stat{grid-column:2;margin-top:5px}.select-check{position:static;grid-column:3;grid-row:1}.panel-head h2{font-size:16px}.builder-foot{align-items:flex-start;flex-direction:column}.builder-foot>div{width:100%;justify-content:flex-end}.builder-foot>span{font-size:8px}.choice-row{gap:9px;padding:11px}.choice-copy small{font-size:8px}.choice-spec{width:55px;font-size:9px}.choice-spec small{font-size:7px}.choice-icon{width:30px;height:30px}.instrument-grid{grid-template-columns:1fr 1fr;gap:8px}.instrument-card{padding:11px;min-height:200px}.instrument-card p{font-size:8px}.instrument-spec{font-size:8px}.orbit-options{grid-template-columns:1fr}.review-row{grid-template-columns:90px 1fr 34px;gap:6px}.review-row strong{font-size:10px}.content-footer{font-size:7px;gap:10px}.content-footer span:last-child{text-align:right}.debrief-content .page-heading{margin-bottom:18px}.outcome-banner{padding:15px;gap:10px}.outcome-icon{width:33px;height:33px;flex:none}.outcome-banner h2{font-size:16px}.outcome-banner p{font-size:9px}.score-ring{width:57px;height:57px;flex:none}.score-ring b{font-size:16px}.score-ring small{font-size:6px}.debrief-grid{grid-template-columns:1fr}.full-card{grid-column:auto}.debrief-facts{gap:10px}.timeline-item{grid-template-columns:22px 1fr;gap:8px}.timeline-item>small{grid-column:2;text-align:left}.learn-grid{grid-template-columns:1fr}.learn-card{min-height:0;padding:15px}.references{align-items:flex-start;flex-direction:column;padding:17px}.reference-links{flex-direction:column;gap:9px}.debrief-actions{justify-content:stretch}.debrief-actions button{flex:1}}
@media(max-width:410px){.top-right .network{font-size:7px}.page-heading h1{font-size:29px}.instrument-grid{grid-template-columns:1fr}.instrument-card{min-height:0}.instrument-spec{max-width:250px}.resource-state{font-size:7px}.resource-numbers>span{font-size:7px}.choice-spec:nth-of-type(4){display:none}.builder-foot .btn-primary,.builder-foot .btn-secondary{padding:9px 10px}.step{font-size:8px}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
